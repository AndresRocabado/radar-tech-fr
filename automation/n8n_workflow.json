        "options": {}
      },
      "id": "7f3d6a2b-0c8e-4d3f-a6b5-2d8e3c5b7a08",
      "name": "Lire le rapport",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [720, 260]
    },
