      "id": "5d1b4e0f-8a6c-4b1d-e4f3-0b6c1a3f5e06",
      "name": "Report",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [240, 260]
    },
    {
      "parameters": {
        "jsCode": "// src/cli.py écrit une seule ligne JSON sur stdout ; les journaux vont sur stderr.\nreturn $input.all().map(item => {\n  const lines = item.json.stdout.trim().split('\\n');\n  return { json: JSON.parse(lines[lines.length - 1]) };\n});"
      },
      "id": "6e2c5f1a-9b7d-4c2e-f5a4-1c7d2b4a6f07",
      "name": "Lire la sortie",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 260]
    },
    {
      "parameters": {
