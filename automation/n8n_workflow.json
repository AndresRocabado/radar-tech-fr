{
  "id": "radarTechFRpipe1",
  "name": "Radar Tech FR — collecte quotidienne et rapport hebdomadaire",
  "nodes": [
    {
      "parameters": {
        "content": "## Radar Tech FR\n**Chaque jour, 06:00** : collecte France Travail puis reconstruction de l'entrepôt DuckDB.\n\n**Chaque lundi, 07:00** : rapport de la semaine écoulée, envoyé par e-mail.\n\nn8n orchestre, le conteneur `radar-worker` calcule. Les deux branches communiquent par l'entrepôt `data/warehouse.duckdb`.\nDocumentation : `docs/automatisation.md`.",
        "height": 240,
        "width": 420
      },
      "id": "0b7c6f0e-6a55-4d0e-9a39-2f1b1c9d0a01",
      "name": "Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [0, -280]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 6 * * *"
            }
          ]
        }
      },
      "id": "1f4d2a9e-3c1b-4b8e-8f0a-6d2e7c9b1a02",
      "name": "Cron quotidien",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://radar-worker:8000/ingest",
        "options": {
          "timeout": 3600000
        }
      },
      "id": "2a8e1b7c-5d3f-4e9a-b1c0-7e3f8d0c2b03",
      "name": "Ingest",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://radar-worker:8000/load",
        "options": {
          "timeout": 1800000
        }
      },
      "id": "3b9f2c8d-6e4a-4fab-c2d1-8f4a9e1d3c04",
      "name": "Load",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 0]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 * * 1"
            }
          ]
        }
      },
      "id": "4c0a3d9e-7f5b-4a0c-d3e2-9a5b0f2e4d05",
      "name": "Cron hebdomadaire",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 260]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://radar-worker:8000/report",
        "options": {
          "timeout": 600000
        }
      },
      "id": "5d1b4e0f-8a6c-4b1d-e4f3-0b6c1a3f5e06",
      "name": "Report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 260]
    },
    {
      "parameters": {
        "mode": "markdownToHtml",
        "markdown": "={{ $json.contenu_markdown }}",
        "destinationKey": "html",
        "options": {
          "tables": true
        }
      },
      "id": "9b5f8c4d-2e0a-4f5b-c8d7-4f0a5e7d9c10",
      "name": "Markdown vers HTML",
      "type": "n8n-nodes-base.markdown",
      "typeVersion": 1,
      "position": [480, 260]
    },
    {
      "parameters": {
        "resource": "email",
        "operation": "send",
        "fromEmail": "={{ $env.RAPPORT_EMAIL_DE }}",
        "toEmail": "={{ $env.RAPPORT_EMAIL_A }}",
        "subject": "={{ $('Report').item.json.objet }}",
        "emailFormat": "html",
        "html": "={{ $json.html }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "0c6a9d5e-3f1b-4a6c-d9e8-5a1b6f8e0d11",
      "name": "Envoi par email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [720, 260]
    }
  ],
  "connections": {
    "Cron quotidien": {
      "main": [[{ "node": "Ingest", "type": "main", "index": 0 }]]
    },
    "Ingest": {
      "main": [[{ "node": "Load", "type": "main", "index": 0 }]]
    },
    "Cron hebdomadaire": {
      "main": [[{ "node": "Report", "type": "main", "index": 0 }]]
    },
    "Report": {
      "main": [[{ "node": "Markdown vers HTML", "type": "main", "index": 0 }]]
    },
    "Markdown vers HTML": {
      "main": [[{ "node": "Envoi par email", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/Paris"
  },
  "pinData": {},
  "active": false,
  "tags": []
}
