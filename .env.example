# Identifiants France Travail (https://francetravail.io, application abonnée
# à l'API Offres d'emploi v2). Copier ce fichier en .env et compléter.
FT_CLIENT_ID=
FT_CLIENT_SECRET=

# Fournisseur LLM de la page « Assistant ».
#   mock      (défaut) : aucune sortie réseau, la réponse se limite au
#                        récapitulatif des statistiques SQL du sous-ensemble.
#   anthropic          : appelle l'API Claude avec LLM_API_KEY.
# La démonstration publique reste sur mock : pas de clé, pas de crédits.
LLM_PROVIDER=mock
LLM_API_KEY=
# Facultatif : modèle interrogé quand LLM_PROVIDER=anthropic (défaut claude-opus-5).
LLM_MODEL=

# Rapport hebdomadaire envoyé par n8n (docker-compose.yml). Seules ces deux
# variables sont transmises au conteneur ; le serveur SMTP et son mot de passe
# se saisissent dans les identifiants n8n, chiffrés dans le volume n8n_data.
RAPPORT_EMAIL_DE=
RAPPORT_EMAIL_A=
